# Logos Blockchain Devnet Environment Variables
# Copy this file to .env and fill in your credentials

# Devnet API credentials (required)
LB_DEVNET_USERNAME=your_username
LB_DEVNET_PASSWORD=your_password

# Optional: Custom devnet config URL
# LB_DEVNET_CONFIG_URL=https://devnet.blockchain.logos.co/node/0/cfgsync/generate-config
